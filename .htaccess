<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirige l'entrée du dossier vers le bundle compilé dist/index.html
  RewriteRule ^$ dist/index.html [L]

  # Éditeur de site : même application, page /edit (les ressources restent relatives au dossier)
  RewriteRule ^edit/?$ dist/index.html [L]
  RewriteRule ^edit/(.+)$ dist/$1 [L,QSA]

  # Redirige tous les appels (assets JS/CSS, images, api-proxy.php) vers dist/
  RewriteCond $1 !^dist/
  RewriteRule ^(.*)$ dist/$1 [L,QSA]
</IfModule>
